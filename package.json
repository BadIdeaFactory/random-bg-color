{
  "name": "@biffud/random-bg-color",
  "version": "2.0.0",
  "description": "Give your site a random background color from the Bad Idea Factory brand guidelines",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BadIdeaFactory/random-bg-color.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BadIdeaFactory/random-bg-color/issues"
  },
  "homepage": "https://github.com/BadIdeaFactory/random-bg-color#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.0"
  }
}
